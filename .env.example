# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.
# Never commit real values, and never paste them into chats.

# Keyed mainnet RPC (e.g. Helius free tier). Leave empty to use the public RPC,
# where holder lookups are often rate-limited and fall back to Jupiter data.
SOLANA_RPC_URL=

# Free key from https://developers.jup.ag/portal — 1 req/s instead of 0.5, so dossiers load ~2x faster.
JUPITER_API_KEY=

# AI analyst. Without a key, Pulse shows a labelled rule-based explanation.
# Option A: Anthropic
ANTHROPIC_API_KEY=
# Option B (free tiers): any OpenAI-compatible API. Leave ANTHROPIC_API_KEY empty.
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=
LLM_API_KEY=
# Model id exactly as listed in your provider's console (default for Anthropic: claude-haiku-5-5)
LLM_MODEL=
AI_ENABLED=true

# On-chain receipts. Create the key with: node scripts/attestor.mjs new
# (writes it to .env.local only). Fund the printed address at https://faucet.solana.com.
ATTESTOR_SECRET_KEY=
ATTEST_CLUSTER=devnet
