# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.
# Never commit real values, and never paste them into chats.

# Keyed mainnet RPC (e.g. Helius free tier). Leave empty to use the public RPC,
# where holder lookups are often rate-limited and fall back to Jupiter data.
SOLANA_RPC_URL=

# Free key from https://developers.jup.ag/portal — 1 req/s instead of 0.5, so dossiers load ~2x faster.
JUPITER_API_KEY=

# Anthropic key for the AI analyst. Without it, Pulse shows a rule-based explanation.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
AI_ENABLED=true
